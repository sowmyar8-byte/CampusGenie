# Choose: ollama (free, local) or anthropic
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Retrieval settings
EMBED_MODEL=BAAI/bge-small-en-v1.5
TOP_K=4
MIN_SCORE=0.35

# Optional reranking stage (downloads a ~1 GB model on first use)
USE_RERANKER=false
RERANK_MODEL=BAAI/bge-reranker-base
CANDIDATES=10

# Hybrid search = meaning-based + keyword (BM25) search combined
USE_HYBRID=true
